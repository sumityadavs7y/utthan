PORT=3000

# development | production
ENV_MODE=development

# --- Local development (default) ---
# Creates database/app.db automatically.
DB_DIALECT=sqlite

# --- Production / docker-compose on EC2 ---
# CI deploy writes these into the server .env (DB_HOST=db is the compose service name).
# DB_DIALECT=postgres
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=utthan
# DB_USER=utthanuser
# DB_PASSWORD=change-me-strong-db-password
# ENV_MODE=production
# SITE_URL=https://theutthanfoundation.in

SESSION_SECRET=change-me-long-random-session-secret
ADMIN_EMAIL=admin@utthan.org
ADMIN_PASSWORD=change-me-strong-admin-password
# Set true once in production to reset the admin password from ADMIN_PASSWORD, then remove it.
# SYNC_ADMIN_PASSWORD=true
SITE_URL=http://localhost:3000
