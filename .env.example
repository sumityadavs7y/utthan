PORT=3000
ENV_MODE=production

# Use DB_HOST=db when running via docker compose (service name).
# Use localhost when running Node directly against a local Postgres.
DB_DIALECT=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=utthan
DB_USER=utthanuser
DB_PASSWORD=change-me-strong-db-password

SESSION_SECRET=change-me-long-random-session-secret
ADMIN_EMAIL=admin@utthan.org
ADMIN_PASSWORD=change-me-strong-admin-password
# Set true once in production to reset the admin password from ADMIN_PASSWORD, then remove it.
# SYNC_ADMIN_PASSWORD=true
SITE_URL=https://theutthanfoundation.in
