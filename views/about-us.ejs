	<button class="scroltop icon-up" type="button"><i class="fas fa-arrow-up"></i></button>
</div>

<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
	<div class="modal fade modal-wrapper" id="modalEditChairmanAbout" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Edit Chairman Section</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><i class="flaticon-close"></i></button>
				</div>
				<form method="POST" action="/team/chairman" enctype="multipart/form-data">
					<input type="hidden" name="returnTo" value="/about-us">
					<div class="modal-body">
						<div class="form-group mb-3">
							<label class="form-label">Name</label>
							<input type="text" name="name" class="form-control" required maxlength="200" value="<%= chairman ? chairman.name : '' %>">
						</div>
						<div class="form-group mb-3">
							<label class="form-label">Role / Title</label>
							<input type="text" name="role" class="form-control" maxlength="200" value="<%= chairman && chairman.role ? chairman.role : '' %>" placeholder="e.g. Lecturer @ SVM Inter College">
						</div>
						<div class="form-group mb-3">
							<label class="form-label">Message</label>
							<textarea name="message" class="form-control" rows="8" required maxlength="10000"><%= chairman ? chairman.message : '' %></textarea>
						</div>
						<div class="row">
							<div class="col-md-6 form-group mb-3">
								<label class="form-label">Photo<%= chairman ? ' (optional replace)' : '' %></label>
								<input type="file" name="photo" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" <%= chairman ? '' : 'required' %>>
							</div>
							<div class="col-md-6 form-group mb-3">
								<label class="form-label">Signature (optional)</label>
								<input type="file" name="signature" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif">
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-secondary">Save Changes</button>
					</div>
				</form>
			</div>
		</div>
	</div>
<% } %>

<%- include('partials/scripts') %>
</body>
