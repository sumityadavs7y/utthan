<!DOCTYPE html>
<html lang="en">
<head>
	<%- include('partials/head') %>
	<style>
		.impact-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
		.impact-card {
			border: 1px solid #e6eef1;
			border-radius: 12px;
			padding: 16px;
			margin-bottom: 16px;
			background: #fff;
		}
		.impact-card img {
			width: 96px;
			height: 96px;
			object-fit: cover;
			border-radius: 10px;
		}
		.impact-quote {
			white-space: pre-wrap;
			color: #4a5a60;
			margin: 8px 0 0;
		}
	</style>
</head>
<body id="bg">
<%- include('partials/loader') %>
<div class="page-wraper">
	<%- include('partials/header') %>

	<div class="page-content bg-white">
		<div class="dz-bnr-inr dz-bnr-inr-sm style-1 text-center overlay-primary-dark" style="background-image:url('/images/banner/bnr1.jpg');">
			<div class="container">
				<div class="dz-bnr-inr-entry">
					<h1>Impact &amp; Testimonials</h1>
					<nav aria-label="breadcrumb" class="breadcrumb-row">
						<ul class="breadcrumb">
							<li class="breadcrumb-item"><a href="/">Home</a></li>
							<li class="breadcrumb-item"><a href="/account">My Account</a></li>
							<li class="breadcrumb-item active" aria-current="page">Impact</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>

		<section class="content-inner-1">
			<div class="container">
				<%- include('partials/flash') %>

				<div class="impact-nav">
					<a class="btn btn-sm btn-secondary" href="#stats">Impact stats</a>
					<a class="btn btn-sm btn-outline-secondary" href="#testimonials">Testimonials</a>
				</div>

				<section id="stats" class="m-b50">
					<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
						<h3 class="mb-0">Impact stats</h3>
						<button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddStat">Add stat</button>
					</div>
					<p class="text-muted">Shown on Home and Become a Member pages.</p>

					<% if (stats && stats.length) { %>
						<% stats.forEach(function(stat) { %>
							<div class="impact-card">
								<form method="POST" action="/admin/impact/stats/<%= stat.id %>/edit">
									<div class="row g-2 align-items-end">
										<div class="col-md-4">
											<label class="form-label">Label</label>
											<input type="text" name="label" class="form-control" required maxlength="120" value="<%= stat.label %>">
										</div>
										<div class="col-md-2">
											<label class="form-label">Value</label>
											<input type="number" name="value" class="form-control" required min="0" value="<%= stat.value %>">
										</div>
										<div class="col-md-2">
											<label class="form-label">Prefix</label>
											<input type="text" name="prefix" class="form-control" maxlength="20" value="<%= stat.prefix || '' %>" placeholder="₹">
										</div>
										<div class="col-md-2">
											<label class="form-label">Suffix</label>
											<input type="text" name="suffix" class="form-control" maxlength="20" value="<%= stat.suffix || '' %>" placeholder="+">
										</div>
										<div class="col-md-1">
											<label class="form-label">Order</label>
											<input type="number" name="sortOrder" class="form-control" value="<%= stat.sortOrder %>">
										</div>
										<div class="col-md-1">
											<button type="submit" class="btn btn-primary btn-sm w-100">Save</button>
										</div>
									</div>
								</form>
								<form method="POST" action="/admin/impact/stats/<%= stat.id %>/delete" class="mt-2" onsubmit="return confirm('Delete this stat?');">
									<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
								</form>
							</div>
						<% }) %>
					<% } else { %>
						<p class="text-muted">No impact stats yet.</p>
					<% } %>
				</section>

				<section id="testimonials">
					<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
						<h3 class="mb-0">Testimonials</h3>
						<button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddTestimonial">Add testimonial</button>
					</div>

					<% if (testimonials && testimonials.length) { %>
						<% testimonials.forEach(function(item) { %>
							<div class="impact-card">
								<div class="d-flex gap-3 flex-wrap">
									<img src="<%= item.imagePath %>" alt="<%= item.name %>">
									<div class="flex-grow-1">
										<strong><%= item.title %></strong>
										<div class="text-muted"><%= item.name %><% if (item.role) { %> · <%= item.role %><% } %></div>
										<p class="impact-quote"><%= item.quote %></p>
										<div class="d-flex gap-2 mt-2">
											<button
												type="button"
												class="btn btn-sm btn-outline-secondary"
												data-bs-toggle="modal"
												data-bs-target="#modalEditTestimonial"
												data-id="<%= item.id %>"
												data-title="<%= encodeURIComponent(item.title) %>"
												data-quote="<%= encodeURIComponent(item.quote) %>"
												data-name="<%= encodeURIComponent(item.name) %>"
												data-role="<%= encodeURIComponent(item.role || '') %>"
												data-sort="<%= item.sortOrder %>"
											>Edit</button>
											<form method="POST" action="/admin/impact/testimonials/<%= item.id %>/delete" class="m-0" onsubmit="return confirm('Delete this testimonial?');">
												<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
											</form>
										</div>
									</div>
								</div>
							</div>
						<% }) %>
					<% } else { %>
						<p class="text-muted">No testimonials yet.</p>
					<% } %>
				</section>
			</div>
		</section>
	</div>

	<%- include('partials/footer') %>
</div>

<div class="modal fade" id="modalAddStat" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form method="POST" action="/admin/impact/stats">
				<div class="modal-header">
					<h5 class="modal-title">Add impact stat</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label">Label</label>
						<input type="text" name="label" class="form-control" required maxlength="120" placeholder="Completed Projects">
					</div>
					<div class="mb-3">
						<label class="form-label">Value</label>
						<input type="number" name="value" class="form-control" required min="0" value="0">
					</div>
					<div class="row">
						<div class="col-md-4 mb-3">
							<label class="form-label">Prefix</label>
							<input type="text" name="prefix" class="form-control" maxlength="20" placeholder="₹">
						</div>
						<div class="col-md-4 mb-3">
							<label class="form-label">Suffix</label>
							<input type="text" name="suffix" class="form-control" maxlength="20" placeholder="+">
						</div>
						<div class="col-md-4 mb-3">
							<label class="form-label">Sort order</label>
							<input type="number" name="sortOrder" class="form-control" value="0">
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary">Add</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="modalAddTestimonial" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<form method="POST" action="/admin/impact/testimonials" enctype="multipart/form-data">
				<div class="modal-header">
					<h5 class="modal-title">Add testimonial</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label">Title</label>
						<input type="text" name="title" class="form-control" required maxlength="200">
					</div>
					<div class="mb-3">
						<label class="form-label">Quote</label>
						<textarea name="quote" class="form-control" rows="5" required maxlength="5000"></textarea>
					</div>
					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">Name</label>
							<input type="text" name="name" class="form-control" required maxlength="120">
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Role / context</label>
							<input type="text" name="role" class="form-control" maxlength="120" placeholder="Volunteer, Parent, etc.">
						</div>
					</div>
					<div class="row">
						<div class="col-md-8 mb-3">
							<label class="form-label">Photo</label>
							<input type="file" name="image" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" required>
						</div>
						<div class="col-md-4 mb-3">
							<label class="form-label">Sort order</label>
							<input type="number" name="sortOrder" class="form-control" value="0">
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary">Add</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="modalEditTestimonial" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<form method="POST" id="formEditTestimonial" action="#" enctype="multipart/form-data">
				<div class="modal-header">
					<h5 class="modal-title">Edit testimonial</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label">Title</label>
						<input type="text" name="title" id="editTitle" class="form-control" required maxlength="200">
					</div>
					<div class="mb-3">
						<label class="form-label">Quote</label>
						<textarea name="quote" id="editQuote" class="form-control" rows="5" required maxlength="5000"></textarea>
					</div>
					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">Name</label>
							<input type="text" name="name" id="editName" class="form-control" required maxlength="120">
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Role / context</label>
							<input type="text" name="role" id="editRole" class="form-control" maxlength="120">
						</div>
					</div>
					<div class="row">
						<div class="col-md-8 mb-3">
							<label class="form-label">Photo (optional replace)</label>
							<input type="file" name="image" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif">
						</div>
						<div class="col-md-4 mb-3">
							<label class="form-label">Sort order</label>
							<input type="number" name="sortOrder" id="editSort" class="form-control" value="0">
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-primary">Save</button>
				</div>
			</form>
		</div>
	</div>
</div>

<%- include('partials/scripts') %>
<script>
	document.getElementById('modalEditTestimonial').addEventListener('show.bs.modal', function (event) {
		var button = event.relatedTarget;
		if (!button) return;
		var id = button.getAttribute('data-id');
		document.getElementById('formEditTestimonial').action = '/admin/impact/testimonials/' + id + '/edit';
		document.getElementById('editTitle').value = decodeURIComponent(button.getAttribute('data-title') || '');
		document.getElementById('editQuote').value = decodeURIComponent(button.getAttribute('data-quote') || '');
		document.getElementById('editName').value = decodeURIComponent(button.getAttribute('data-name') || '');
		document.getElementById('editRole').value = decodeURIComponent(button.getAttribute('data-role') || '');
		document.getElementById('editSort').value = button.getAttribute('data-sort') || '0';
	});
</script>
</body>
</html>
