<%- include('partials/head-open') %>
<% const hero = blocks.hero || {}; const messageHead = blocks['message-heading'] || {}; const joinHead = blocks['join-heading'] || {}; const officesHead = blocks['offices-heading'] || {}; %>

<section class="contact-hero cms-relative">
  <%- include('partials/cms-bar', { permission: 'contact.edit', editType: 'page-block', id: hero.id }) %>
  <div class="contact-hero__media" aria-hidden="true">
    <img src="<%= hero.imageUrl || '' %>" alt="">
  </div>
  <div class="contact-hero__overlay"></div>
  <div class="container contact-hero__content">
    <p class="eyebrow"><%= hero.eyebrow || 'Contact' %></p>
    <h1><%= hero.title || 'Talk with Utthan' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
  </div>
</section>

<nav class="contact-jump" aria-label="Contact sections">
  <div class="container contact-jump__inner">
    <a href="#message"><%= messageHead.title || 'Send a message' %></a>
    <a href="#join"><%= joinHead.title || 'Join us' %></a>
    <a href="#offices"><%= officesHead.title || 'Our offices' %></a>
  </div>
</nav>

<section id="message" class="section">
  <div class="container contact-block">
    <header class="contact-block__head cms-relative">
      <%- include('partials/cms-bar', { permission: 'contact.edit', editType: 'page-block', id: messageHead.id }) %>
      <h2><%= messageHead.title || 'Send a message' %></h2>
      <p><%= messageHead.lede || '' %></p>
    </header>
    <form class="contact-form" method="post" action="/contact" novalidate>
      <%- csrfField %>
      <div class="contact-form__row">
        <label>
          First name *
          <input type="text" name="firstName" required value="<%= form.firstName || '' %>">
        </label>
        <label>
          Last name
          <input type="text" name="lastName" value="<%= form.lastName || '' %>">
        </label>
      </div>
      <div class="contact-form__row">
        <label>
          Email *
          <input type="email" name="email" required value="<%= form.email || '' %>">
        </label>
        <label>
          Phone
          <input type="tel" name="phone" value="<%= form.phone || '' %>">
        </label>
      </div>
      <label>
        Message *
        <textarea name="message" rows="6" required><%= form.message || '' %></textarea>
      </label>
      <button class="btn btn--primary contact-form__submit" type="submit">Send message</button>
    </form>
  </div>
</section>

<section id="join" class="section section--tint">
  <div class="container contact-block">
    <header class="contact-block__head cms-relative">
      <%- include('partials/cms-bar', { permission: 'contact.edit', editType: 'page-block', id: joinHead.id }) %>
      <h2><%= joinHead.title || 'Join us' %></h2>
      <p><%= joinHead.lede || '' %></p>
      <% if (siteConfig && siteConfig.memberFeeNote) { %>
        <p class="contact-block__note"><%= siteConfig.memberFeeNote %></p>
      <% } %>
    </header>
    <form class="contact-form" method="post" action="/join/volunteer" novalidate>
      <%- csrfField %>
      <div class="contact-form__row">
        <label>
          Full name *
          <input type="text" name="name" required>
        </label>
        <label>
          Email *
          <input type="email" name="email" required>
        </label>
      </div>
      <div class="contact-form__row">
        <label>
          Phone
          <input type="tel" name="phone">
        </label>
        <label>
          Organization / college
          <input type="text" name="company">
        </label>
      </div>
      <label>
        How would you like to help? *
        <textarea name="message" rows="5" required placeholder="Volunteer shifts, membership, skills you can offer…"></textarea>
      </label>
      <button class="btn btn--primary contact-form__submit" type="submit">Submit interest</button>
    </form>
  </div>
</section>

<section id="offices" class="section">
  <div class="container">
    <header class="contact-block__head contact-block__head--wide cms-relative">
      <%- include('partials/cms-bar', { permission: 'contact.edit', editType: 'page-block', id: officesHead.id, addType: 'office', addPermission: 'offices.edit' }) %>
      <h2><%= officesHead.title || 'Our offices' %></h2>
      <p><%= officesHead.lede || '' %></p>
    </header>
    <div class="office-rail">
      <% offices.forEach(function(office) { %>
        <article class="office-rail__item cms-relative">
          <%- include('partials/cms-bar', { permission: 'offices.edit', editType: 'office', id: office.id, canDelete: true }) %>
          <p class="eyebrow"><%= office.label %></p>
          <p class="office-rail__address"><%= office.address %></p>
          <% if (office.phone) { %>
            <a class="office-rail__link" href="tel:<%= String(office.phone).replace(/\s/g, '') %>"><%= office.phone %></a>
          <% } %>
          <% if (office.email) { %>
            <a class="office-rail__link" href="mailto:<%= office.email %>"><%= office.email %></a>
          <% } %>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/head-close') %>
