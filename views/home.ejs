<%- include('partials/head-open') %>
<% const hero = blocks.hero || {}; const campHead = blocks['campaigns-heading'] || {}; const doHead = blocks['what-we-do-heading'] || {}; const join = blocks.join || {}; const storiesHead = blocks['stories-heading'] || {}; const partnersHead = blocks['partners-heading'] || {}; const focusAreas = typeof features !== 'undefined' ? features : []; %>

<section class="hero cms-relative">
  <%- include('partials/cms-bar', { permission: 'home.edit', editType: 'page-block', id: hero.id }) %>
  <div class="hero__media" aria-hidden="true">
    <img src="<%= hero.imageUrl || '' %>" alt="">
  </div>
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <p class="eyebrow"><%= hero.eyebrow || 'The Utthan Foundation' %></p>
    <h1><%= hero.title || 'Neighbors rising together across Uttar Pradesh' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
    <div class="hero__actions">
      <% if (hero.extra && hero.extra.ctaPrimaryLabel) { %>
        <a class="btn btn--primary" href="<%= hero.extra.ctaPrimaryHref || '/donate' %>"><%= hero.extra.ctaPrimaryLabel %></a>
      <% } %>
      <% if (hero.extra && hero.extra.ctaSecondaryLabel) { %>
        <a class="btn btn--ghost" href="<%= hero.extra.ctaSecondaryHref || '/campaigns' %>"><%= hero.extra.ctaSecondaryLabel %></a>
      <% } %>
    </div>
  </div>
</section>

<section class="stats-strip">
  <div class="container">
    <div class="cms-heading-row">
      <%- include('partials/cms-bar', { permission: 'stats.edit', addType: 'stat' }) %>
    </div>
    <% if (stats && stats.length) { %>
      <div class="stats-grid">
        <% stats.forEach(function(stat) { %>
          <div class="stat cms-relative">
            <%- include('partials/cms-bar', { permission: 'stats.edit', editType: 'stat', id: stat.id, canDelete: true }) %>
            <strong><%= stat.prefix || '' %><%= Number(stat.value).toLocaleString('en-IN') %><%= stat.suffix || '' %></strong>
            <span><%= stat.label %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('partials/cms-bar', { permission: 'home.edit', editType: 'page-block', id: campHead.id }) %>
      <h2><%= campHead.title || 'Ongoing campaigns' %></h2>
      <p><%= campHead.lede || '' %></p>
    </div>
    <% if (ongoingCampaigns.length) { %>
      <div class="slider" data-slider>
        <div class="slider__track" data-slider-track>
          <% ongoingCampaigns.forEach(function(c) { %>
            <article class="slider__slide">
              <a href="/campaigns/<%= c.slug %>" class="campaign-card">
                <div class="campaign-card__media">
                  <img src="<%= c.imageUrl %>" alt="<%= c.title %>">
                  <span class="badge"><%= c.status %></span>
                </div>
                <div class="campaign-card__body">
                  <h3><%= c.title %></h3>
                  <p><%= c.summary %></p>
                  <div class="progress">
                    <div class="progress__bar" style="width: <%= c.progress %>%"></div>
                  </div>
                  <p class="progress__meta"><%= c.raisedFormatted %> raised of <%= c.goalFormatted %></p>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
        <div class="slider__controls">
          <button type="button" data-slider-prev aria-label="Previous">‹</button>
          <button type="button" data-slider-next aria-label="Next">›</button>
        </div>
      </div>
    <% } else { %>
      <p class="muted">No ongoing campaigns yet.</p>
    <% } %>
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('partials/cms-bar', { permission: 'home.edit', editType: 'page-block', id: doHead.id }) %>
      <%- include('partials/cms-bar', { permission: 'home.edit', addType: 'home-feature' }) %>
      <h2><%= doHead.title || 'What we do' %></h2>
      <p><%= doHead.lede || '' %></p>
    </div>
    <% if (focusAreas.length) { %>
      <div class="feature-grid">
        <% focusAreas.forEach(function(feature) { %>
          <article class="feature cms-relative">
            <%- include('partials/cms-bar', { permission: 'home.edit', editType: 'home-feature', id: feature.id, canDelete: true }) %>
            <img src="<%= feature.imageUrl || '' %>" alt="<%= feature.alt || feature.title || '' %>">
            <h3><%= feature.title %></h3>
            <p><%= feature.body %></p>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="muted">No focus areas yet.</p>
    <% } %>
  </div>
</section>

<section class="join-split cms-relative" aria-labelledby="join-heading">
  <%- include('partials/cms-bar', { permission: 'home.edit', editType: 'page-block', id: join.id }) %>
  <div class="join-split__media">
    <img src="<%= join.imageUrl || '' %>" alt="<%= join.alt || '' %>">
  </div>
  <div class="join-split__content">
    <div class="join-split__content-inner">
      <h2 id="join-heading"><%= join.title || 'Join us' %></h2>
      <p class="join-split__lede"><%= join.lede || '' %></p>
      <div class="join-split__actions">
        <% if (join.extra && join.extra.ctaPrimaryLabel) { %>
          <a class="btn btn--primary" href="<%= join.extra.ctaPrimaryHref || '/contact#join' %>"><%= join.extra.ctaPrimaryLabel %></a>
        <% } %>
        <% if (join.extra && join.extra.ctaSecondaryLabel) { %>
          <a class="btn btn--secondary" href="<%= join.extra.ctaSecondaryHref || '/contact#join' %>"><%= join.extra.ctaSecondaryLabel %></a>
        <% } %>
      </div>
      <% if (siteConfig && siteConfig.memberFeeNote) { %>
        <p class="join-split__fee"><%= siteConfig.memberFeeNote %></p>
      <% } %>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('partials/cms-bar', { permission: 'home.edit', editType: 'page-block', id: storiesHead.id }) %>
      <%- include('partials/cms-bar', { permission: 'stories.edit', addType: 'testimonial' }) %>
      <h2><%= storiesHead.title || 'Success stories' %></h2>
      <p><%= storiesHead.lede || '' %></p>
    </div>
    <% if (testimonials.length) { %>
      <div class="slider" data-slider>
        <div class="slider__track" data-slider-track>
          <% testimonials.forEach(function(t) { %>
            <article class="slider__slide cms-relative">
              <%- include('partials/cms-bar', { permission: 'stories.edit', editType: 'testimonial', id: t.id, canDelete: true }) %>
              <button
                type="button"
                class="campaign-card campaign-card--button"
                data-story-open
                data-story-image="<%= t.imageUrl %>"
                data-story-title="<%= t.title %>"
                data-story-quote="<%= t.quote %>"
                data-story-name="<%= t.name %>"
                data-story-role="<%= t.role || '' %>"
                aria-label="Read success story: <%= t.title %>"
              >
                <div class="campaign-card__media">
                  <img src="<%= t.imageUrl %>" alt="">
                  <span class="badge">Story</span>
                </div>
                <div class="campaign-card__body">
                  <h3><%= t.title %></h3>
                  <p><%= t.quote %></p>
                  <div class="progress" aria-hidden="true">
                    <div class="progress__bar" style="width: 100%"></div>
                  </div>
                  <p class="progress__meta">
                    <strong><%= t.name %></strong><% if (t.role) { %> — <%= t.role %><% } %>
                  </p>
                </div>
              </button>
            </article>
          <% }) %>
        </div>
        <div class="slider__controls">
          <button type="button" data-slider-prev aria-label="Previous">‹</button>
          <button type="button" data-slider-next aria-label="Next">›</button>
        </div>
      </div>

      <div class="story-modal" data-story-modal hidden>
        <div class="story-modal__backdrop" data-story-close tabindex="-1"></div>
        <div
          class="story-modal__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="story-modal-title"
        >
          <button type="button" class="story-modal__close" data-story-close aria-label="Close story">×</button>
          <div class="story-modal__scroll">
            <div class="story-modal__media">
              <img src="" alt="" data-story-modal-image>
            </div>
            <div class="story-modal__body">
              <span class="badge">Story</span>
              <h3 id="story-modal-title" data-story-modal-title></h3>
              <p data-story-modal-quote></p>
              <p class="progress__meta" data-story-modal-meta></p>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <p class="muted">No success stories yet.</p>
    <% } %>
  </div>
</section>

<section class="section partners-section">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('partials/cms-bar', { permission: 'partners.edit', listType: 'partner', listLabel: 'Edit' }) %>
      <h2><%= partnersHead.title || 'Our partners' %></h2>
      <p><%= partnersHead.lede || '' %></p>
    </div>
    <% if (partners && partners.length) { %>
      <div class="partners-marquee" data-partners-marquee>
        <div class="partners-marquee__viewport">
          <div class="partners-marquee__track" data-partners-track>
            <ul class="partners-marquee__set" data-partners-set>
              <% partners.forEach(function(p) { %>
                <% const showLogo = Boolean(p.logoUrl); %>
                <% const showName = Boolean(p.name) && (p.showName !== false || !showLogo); %>
                <li class="partner-item<%= showLogo && showName ? ' partner-item--both' : (showLogo ? ' partner-item--logo' : ' partner-item--name') %>">
                  <% if (showLogo) { %>
                    <span class="partner-item__mark">
                      <img src="<%= p.logoUrl %>" alt="<%= showName ? '' : (p.name || 'Partner') %>" width="36" height="36" decoding="async">
                    </span>
                  <% } %>
                  <% if (showName) { %>
                    <span class="partner-item__name"><%= p.name %></span>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/head-close') %>
