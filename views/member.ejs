<!DOCTYPE html>
<html lang="en-IN">
<head>
	<%- include('partials/head') %>
</head>
<body id="bg">
<%- include('partials/loader') %>
<div class="page-wraper">
	<%- include('partials/header') %>

<div id="main-content" class="page-content bg-white">
		
		<!-- Banner  -->
		<div class="dz-bnr-inr style-1 text-center overlay-primary-dark" style="background-image:url('/images/banner/bnr3.jpg');">
			<div class="container">
				<div class="dz-bnr-inr-entry">
					<h1>Become A Volunteer</h1>
					<!-- Breadcrumb Row -->
					<nav aria-label="breadcrumb" class="breadcrumb-row">
						<ul class="breadcrumb">
							<li class="breadcrumb-item"><a href="/">Home</a></li>
							<li class="breadcrumb-item active" aria-current="page">Become A Volunteer</li>
						</ul>
					</nav>
					<!-- Breadcrumb Row End -->
				</div>
			</div>
		</div>
		<!-- Banner End -->
		
		<!-- Volunteer -->
		<section class="gradient-white" style="background-image:url('/images/background/bg10.jpg'); background-position: center;">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-xl-9 col-md-9 col-sm-12">
						<div class="form-wrapper style-3">
							<div class="contact-area">
								<form class="dz-form dzForm contact-bx" method="POST" action="/api/volunteer">
									<div class="dzFormMsg"></div>
									<input type="hidden" class="form-control" name="dzToDo" value="Volunteer">
									<input type="hidden" class="form-control" name="reCaptchaEnable" value="0">
									
									<div class="row sp15">
										<div class="col-md-12">
											<label class="form-label">Full Name</label>
											<div class="input-group">
												<input name="dzName" required type="text" class="form-control" placeholder="xyz xyz">
											</div>
										</div>
										<div class="col-md-6">
											<label class="form-label">Email address</label>
											<div class="input-group">
												<input name="dzEmail" required type="email" class="form-control" placeholder="xyz@mail.com">
											</div>
										</div>
										<div class="col-md-6">
											<label class="form-label">Phone Number</label>
											<div class="input-group">
												<input name="dzPhoneNumber" required type="text" class="form-control" placeholder="987 654 3210">
											</div>
										</div>
										<div class="col-md-12">
											<label class="form-label">Company Name</label>
											<div class="input-group">
												<input name="dzCompany" type="text" class="form-control" placeholder="xyz Studios">
											</div>
										</div>
										<div class="col-md-12">
											<label class="form-label">Message</label>
											<div class="input-group">
												<textarea name="dzMessage" rows="5" required class="form-control" placeholder="Dear Sir/Madam"></textarea>
											</div>
										</div>
										<div class="col-md-12 m-b20">
											<div class="form-check">
												<input class="form-check-input" type="checkbox" value="1" id="flexCheckDefault" name="dzAcceptTerms" required>
												<label class="form-check-label" for="flexCheckDefault">
													Accept terms & conditions
												</label>
											</div>
										</div>
										<div class="col-md-12">
											<button name="submit" type="submit" value="Submit" class="btn btn-secondary effect">SEND</button>
										</div>
									</div>
								</form>
							</div>	
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- volunteer -->
		
		<!-- Our Mission -->
		<section class="content-inner-2">
			<div class="container">
				<div class="row about-bx3 align-items-center">
					<div class="col-lg-5">
						<div class="dz-media">
							<img src="/images/main-slider/pic1.jpg" alt="Utthan Foundation members and volunteers making an impact">
						</div>
					</div>
					<div class="col-lg-7 m-b50">
						<div class="section-head">
							<h5 class="sub-title">Our Mission</h5>
							<h2>Change The World for Better Futures</h2>
							<p class="m-t20">Our mission is to empower the vulnerable and build a stronger community through education, support, and assistance for the poor, homeless, and underprivileged.</p>
						</div>
						<div class="row">
							<% (impactStats || []).slice(0, 3).forEach(function(stat) { %>
								<div class="col-lg-3 col-sm-4 col-6 m-b30">
									<h2>
										<% if (stat.prefix) { %><%= stat.prefix %> <% } %><span class="counter"><%= stat.value %></span><% if (stat.suffix) { %><%= stat.suffix %><% } %>
									</h2>
									<span class="counter-text"><%= stat.label %></span>
								</div>
							<% }) %>
						</div>
						<a href="/about-us" class="m-r30 m-sm-r10 btn btn-secondary">See Projects <i class="flaticon-right-arrows ps-3"></i></a>
						<a href="/team" class="btn btn-outline-dark">More About Us</a>
					</div>
				</div>
			</div>
		</section>
		
		<!-- Counter -->
		<% if (impactStats && impactStats.length) { %>
			<div class="counter-wrapper-1">
				<div class="container">
					<div class="counter-inner bg-secondary">
						<div class="row">
							<% impactStats.forEach(function(stat) { %>
								<div class="col-lg-3 col-6 m-b30">
									<div class="counter-style-1 text-center">
										<span class="counter-num">
											<% if (stat.prefix) { %><%= stat.prefix %> <% } %><span class="counter"><%= stat.value %></span><% if (stat.suffix) { %> <%= stat.suffix %><% } %>
										</span>
										<p class="counter-text"><%= stat.label %></p>
									</div>
								</div>
							<% }) %>
						</div>
						<img src="/images/counter/pattren1.png" class="pattren1 move-2" alt="" aria-hidden="true">
						<img src="/images/counter/pattren2.png" class="pattren2 move-2" alt="" aria-hidden="true">
						<img src="/images/counter/pattren3.png" class="pattren3 move-2" alt="" aria-hidden="true">
						<img src="/images/counter/pattren4.png" class="pattren4 move-2" alt="" aria-hidden="true">
						<img src="/images/counter/pattren5.png" class="pattren5 move-2" alt="" aria-hidden="true">
						<img src="/images/counter/pattren6.png" class="pattren6 move-2" alt="" aria-hidden="true">
					</div>
				</div>
			</div>
		<% } %>
		<!-- Counter End -->
		
		<!-- Categories -->
		<section class="content-inner">
			<div class="container">
				<div class="section-head text-center">
					<h5 class="sub-title">CATEGORIES</h5>
					<h2 class="title">Explore Utthan Foundation's <br> Featured Categories</h2>
					<p>As a member of Utthan Foundation, we support efforts in charity, medical services, education, animal rescue, and  special care for specially-abled people.</p>
				</div>
				<div class="row">
					<div class="col-xl-3 col-sm-6">
						<div class="icon-bx-wraper style-1 text-center m-b30">
							<div class="icon-lg m-b30"> <a href="/about-us" class="icon-cell">
								<i class="flaticon-like-1"></i>
							</a> </div>
							<div class="icon-content">
								<h5 class="dz-tilte text-capitalize"><a href="/about-us">Giving Love</a></h5>
								<p>We care about the specially abled peoson and the old ones </p>
							</div>
						</div>
					</div>
					<div class="col-xl-3 col-sm-6">
						<div class="icon-bx-wraper style-1 text-center m-b30">
							<div class="icon-lg m-b30"> <a href="/about-us" class="icon-cell">
								<i class="flaticon-open-book"></i>
							</a> </div>
							<div class="icon-content">
								<h5 class="dz-tilte m-b5 text-capitalize"><a href="/about-us">Education</a></h5>
								<p>We provide education to the remote and inaccessible areas</p>
							</div>
						</div>
					</div>
					<div class="col-xl-3 col-sm-6">
						<div class="icon-bx-wraper style-1 text-center m-b30">
							<div class="icon-lg m-b30"> <a href="/about-us" class="icon-cell">
								<i class="flaticon-raw-food"></i>
							</a> </div>
							<div class="icon-content">
								<h5 class="dz-tilte m-b5 text-capitalize"><a href="/about-us">Healthy Food</a></h5>
								<p>By donating food to the deprived ones who are in need</p>
							</div>
						</div>
					</div>
					<div class="col-xl-3 col-sm-6">
						<div class="icon-bx-wraper style-1 text-center m-b30">
							<div class="icon-lg m-b30"> <a href="/about-us" class="icon-cell">
								<i class="flaticon-doctor-bag"></i>
							</a> </div>
							<div class="icon-content">
								<h5 class="dz-tilte m-b5 text-capitalize"><a href="/about-us">Medical</a></h5>
								<p>Access to medical services is a right of every indian citizen </p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- categories -->
		
		
</div>


	<%- include('partials/related-links') %>
	<%- include('partials/newsletter') %>
	<%- include('partials/footer') %>

	<button class="scroltop icon-up" type="button"><i class="fas fa-arrow-up"></i></button>
</div>
<%- include('partials/scripts') %>
</body>
</html>
