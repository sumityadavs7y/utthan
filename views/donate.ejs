<%- include('partials/head-open') %>
<% const hero = blocks.hero || {}; %>

<section class="page-hero cms-relative">
  <%- include('partials/cms-bar', { permission: 'donate.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'Donate' %></p>
    <h1><%= hero.title || 'Donate to The Utthan Foundation' %></h1>
    <p class="lede">
      <% if (campaign) { %>
        <% if (hero.extra && hero.extra.campaignLede) { %>
          <%= hero.extra.campaignLede.replace('{title}', campaign.title) %>
        <% } else { %>
          Supporting: <strong><%= campaign.title %></strong>. Every gift funds food, education, livelihood, and care across Uttar Pradesh.
        <% } %>
      <% } else { %>
        <%= hero.lede || '' %>
      <% } %>
    </p>
  </div>
</section>

<section class="section donate-page">
  <div class="container">
    <div class="donate-sheet cms-relative">
      <% if (siteConfig) { %>
        <%- include('partials/cms-bar', { permission: 'settings.edit', editType: 'site-config', id: siteConfig.id }) %>
      <% } %>

      <% if (siteConfig && (siteConfig.qrUrl || siteConfig.upiId)) { %>
        <div class="donate-sheet__scan">
          <p class="donate-sheet__kicker">UPI</p>
          <h2>Scan to donate</h2>
          <% if (siteConfig.qrUrl) { %>
            <div class="donate-qr">
              <img class="qr" src="<%= siteConfig.qrUrl %>" alt="Donation QR code">
            </div>
          <% } %>
          <% if (siteConfig.upiId) { %>
            <div class="donate-upi">
              <p class="donate-upi__label">UPI ID</p>
              <p class="donate-upi__value"><code><%= siteConfig.upiId %></code></p>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (siteConfig && (siteConfig.accountName || siteConfig.bankName || siteConfig.accountNumber || siteConfig.ifsc)) { %>
        <div class="donate-sheet__bank">
          <h2>Bank transfer</h2>
          <dl class="donate-rows">
            <% if (siteConfig.accountName) { %>
              <div>
                <dt>Account name</dt>
                <dd><%= siteConfig.accountName %></dd>
              </div>
            <% } %>
            <% if (siteConfig.bankName) { %>
              <div>
                <dt>Bank</dt>
                <dd><%= siteConfig.bankName %></dd>
              </div>
            <% } %>
            <% if (siteConfig.accountNumber) { %>
              <div>
                <dt>Account number</dt>
                <dd><code><%= siteConfig.accountNumber %></code></dd>
              </div>
            <% } %>
            <% if (siteConfig.ifsc) { %>
              <div>
                <dt>IFSC</dt>
                <dd><code><%= siteConfig.ifsc %></code></dd>
              </div>
            <% } %>
          </dl>
        </div>
      <% } %>

      <% if (siteConfig && siteConfig.donationLink) { %>
        <div class="donate-sheet__cta">
          <p>Prefer to pay online?</p>
          <a class="btn btn--donate" href="<%= siteConfig.donationLink %>" target="_blank" rel="noopener noreferrer">Donate now</a>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/head-close') %>
