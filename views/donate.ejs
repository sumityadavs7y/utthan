<!DOCTYPE html>
<html lang="en-IN">
<head>
	<%- include('partials/head') %>
</head>
<body id="bg">
<%- include('partials/loader') %>
<div class="page-wraper">
	<%- include('partials/header') %>

	<div id="main-content" class="page-content bg-white">
		<div class="dz-bnr-inr dz-bnr-inr-sm style-1 text-center overlay-primary-dark" style="background-image:url('/images/banner/bnr4.jpg');">
			<div class="container">
				<div class="dz-bnr-inr-entry">
					<h1>Donate</h1>
					<nav aria-label="breadcrumb" class="breadcrumb-row">
						<ul class="breadcrumb">
							<li class="breadcrumb-item"><a href="/">Home</a></li>
							<li class="breadcrumb-item active" aria-current="page">Donate</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>

		<%- include('partials/trust-bar') %>

		<section class="content-inner-2 bg-light">
			<div class="container">
				<div class="row about-bx3 align-items-center">
					<div class="col-lg-5 m-b30">
						<div class="dz-media text-center">
							<img src="/images/main-slider/scan.png" alt="Utthan Foundation donation QR code for UPI payments" width="420" height="420" loading="eager">
							<p class="mt-3 mb-0 text-muted">Scan this QR code to donate via UPI</p>
						</div>
					</div>
					<div class="col-lg-7 m-b30">
						<div class="section-head">
							<h5 class="sub-title">Support Our Work</h5>
							<h2>Your donation creates real impact</h2>
							<p class="m-t20">Contribute to education, healthcare, shelters, and livelihood programs for underprivileged communities. Choose any convenient payment method below.</p>
						</div>

						<div class="donate-details-card">
							<h3 class="h5">Bank transfer</h3>
							<p class="mb-2"><strong>Account name:</strong> Utthan Foundation</p>
							<div class="donate-copy-row">
								<strong>A/C No:</strong>
								<code id="donateAccount">7396207107</code>
								<button type="button" class="btn btn-sm btn-outline-secondary js-copy" data-copy="7396207107">Copy</button>
							</div>
							<div class="donate-copy-row">
								<strong>IFSC:</strong>
								<code id="donateIfsc">IDIB000A532</code>
								<button type="button" class="btn btn-sm btn-outline-secondary js-copy" data-copy="IDIB000A532">Copy</button>
							</div>
							<p class="mb-0 text-muted">Indian Bank</p>
						</div>

						<div class="mt-3">
							<a href="https://www.instamojo.com/@theutthanfoundation" class="btn btn-secondary me-2 mb-2" target="_blank" rel="noopener noreferrer">Pay via Net Banking / Instamojo</a>
							<a href="/campaigns" class="btn btn-outline-secondary mb-2">View Campaigns</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="content-inner-1">
			<div class="container">
				<div class="row">
					<div class="col-lg-4 m-b30">
						<div class="donate-details-card h-100">
							<h3 class="h5">Education</h3>
							<p class="mb-0">Help children continue schooling with books, fees, and learning support.</p>
						</div>
					</div>
					<div class="col-lg-4 m-b30">
						<div class="donate-details-card h-100">
							<h3 class="h5">Healthcare</h3>
							<p class="mb-0">Support medical care and emergency assistance for families in need.</p>
						</div>
					</div>
					<div class="col-lg-4 m-b30">
						<div class="donate-details-card h-100">
							<h3 class="h5">Community care</h3>
							<p class="mb-0">Fund shelters, livelihood help, and outreach for vulnerable communities.</p>
						</div>
					</div>
				</div>
				<p class="text-center mb-0">Questions before donating? Read our <a href="/faq">FAQ</a> or <a href="/contact">contact us</a>.</p>
			</div>
		</section>

		<%- include('partials/related-links') %>
	</div>

	<%- include('partials/newsletter') %>
	<%- include('partials/footer') %>
	<button class="scroltop icon-up" type="button" aria-label="Scroll to top"><i class="fas fa-arrow-up"></i></button>
</div>
<%- include('partials/scripts') %>
<script>
	document.querySelectorAll('.js-copy').forEach(function (button) {
		button.addEventListener('click', async function () {
			var value = button.getAttribute('data-copy') || '';
			try {
				await navigator.clipboard.writeText(value);
				var original = button.textContent;
				button.textContent = 'Copied';
				setTimeout(function () { button.textContent = original; }, 1500);
			} catch (error) {
				button.textContent = 'Copy failed';
			}
		});
	});
</script>
</body>
</html>
