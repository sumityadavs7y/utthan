<%- include('partials/head-open') %>
<% const hero = blocks.hero || {}; %>

<section class="page-hero cms-relative">
  <%- include('partials/cms-bar', { permission: 'blogs.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'Blogs & Media' %></p>
    <h1><%= hero.title || 'Stories from The Utthan Foundation' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cms-heading-row">
      <% if (tab === 'blogs') { %>
        <%- include('partials/cms-bar', { permission: 'blogs.edit', addType: 'post' }) %>
      <% } else { %>
        <%- include('partials/cms-bar', { permission: 'media.edit', addType: 'gallery' }) %>
      <% } %>
    </div>
    <div class="tabs" role="tablist">
      <a class="tabs__item <%= tab === 'blogs' ? 'is-active' : '' %>" href="/blogs?tab=blogs">Blogs</a>
      <a class="tabs__item <%= tab === 'media' ? 'is-active' : '' %>" href="/blogs?tab=media">Media</a>
    </div>

    <% if (tab === 'blogs') { %>
      <% if (posts.length) { %>
        <div class="blog-grid">
          <% posts.forEach(function(post) { %>
            <div class="cms-relative">
              <%- include('partials/cms-bar', { permission: 'blogs.edit', editType: 'post', id: post.id, canDelete: true }) %>
              <button
                type="button"
                class="blog-card blog-card--button"
                data-content-open
                data-content-type="blog"
                data-content-badge="Blog"
                data-content-title="<%= post.title %>"
                data-content-meta="<%= post.category %> · <%= post.dateFormatted %>"
                data-content-image="<%= post.imageUrl || '' %>"
                aria-label="Read blog: <%= post.title %>"
              >
                <span class="u-hidden" data-content-images><%= JSON.stringify(post.photos || []) %></span>
                <% if (post.imageUrl) { %>
                  <img src="<%= post.imageUrl %>" alt="">
                <% } %>
                <div class="blog-card__body">
                  <p class="eyebrow"><%= post.category %> · <%= post.dateFormatted %></p>
                  <h3><%= post.title %></h3>
                  <p class="blog-card__preview"><%= post.preview %></p>
                  <% if (post.isTruncated) { %>
                    <span class="blog-card__more">Read more</span>
                  <% } %>
                </div>
                <span class="u-hidden" data-content-full><%= post.content %></span>
              </button>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted">No blog posts yet.</p>
      <% } %>
    <% } else { %>
      <% if (media.length) { %>
        <div class="media-grid">
          <% media.forEach(function(item) { %>
            <div class="cms-relative">
              <%- include('partials/cms-bar', { permission: 'media.edit', editType: 'gallery', id: item.id, canDelete: true }) %>
              <button
                type="button"
                class="media-tile media-tile--button"
                data-content-open
                data-content-type="media"
                data-content-badge="Media"
                data-content-title="<%= item.title || item.caption || 'Media' %>"
                data-content-meta="<%= item.dateFormatted || '' %>"
                data-content-image="<%= item.imageUrl %>"
                aria-label="Open media: <%= item.caption || item.title || 'Photo' %>"
              >
                <img src="<%= item.imageUrl %>" alt="">
                <span class="media-tile__caption">
                  <span><%= item.caption || item.title || 'Untitled' %></span>
                  <% if (item.dateFormatted) { %>
                    <time><%= item.dateFormatted %></time>
                  <% } %>
                </span>
                <span class="u-hidden" data-content-full><%= item.caption || item.title || '' %></span>
              </button>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted">No media yet.</p>
      <% } %>
    <% } %>

    <% if (pagination && pagination.totalPages > 1) { %>
      <nav class="pagination" aria-label="Pagination">
        <% if (pagination.hasPrev) { %>
          <a class="pagination__btn" href="<%= pagination.prevHref %>" aria-label="Previous page">‹ Prev</a>
        <% } else { %>
          <span class="pagination__btn is-disabled" aria-disabled="true">‹ Prev</span>
        <% } %>

        <div class="pagination__pages">
          <% pagination.pages.forEach(function(p) { %>
            <% if (p.isCurrent) { %>
              <span class="pagination__page is-current" aria-current="page"><%= p.number %></span>
            <% } else { %>
              <a class="pagination__page" href="<%= p.href %>"><%= p.number %></a>
            <% } %>
          <% }) %>
        </div>

        <% if (pagination.hasNext) { %>
          <a class="pagination__btn" href="<%= pagination.nextHref %>" aria-label="Next page">Next ›</a>
        <% } else { %>
          <span class="pagination__btn is-disabled" aria-disabled="true">Next ›</span>
        <% } %>
      </nav>
    <% } %>
  </div>
</section>

<div class="story-modal" data-content-modal hidden>
  <div class="story-modal__backdrop" data-content-close tabindex="-1"></div>
  <div
    class="story-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="content-modal-title"
  >
    <button type="button" class="story-modal__close" data-content-close aria-label="Close">×</button>
    <div class="story-modal__scroll">
      <div class="story-modal__media" data-content-modal-media>
        <div class="story-slider" data-story-slider>
          <div class="story-slider__track" data-story-slider-track></div>
          <button type="button" class="story-slider__nav story-slider__nav--prev" data-story-slider-prev aria-label="Previous photo">‹</button>
          <button type="button" class="story-slider__nav story-slider__nav--next" data-story-slider-next aria-label="Next photo">›</button>
          <div class="story-slider__dots" data-story-slider-dots></div>
        </div>
      </div>
      <div class="story-modal__body">
        <span class="badge" data-content-modal-badge>Blog</span>
        <h3 id="content-modal-title" data-content-modal-title></h3>
        <p data-content-modal-text></p>
        <p class="progress__meta" data-content-modal-meta></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/head-close') %>
