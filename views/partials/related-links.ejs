<%
	const relatedLinks = [
		{ href: '/donate', label: 'Donate' },
		{ href: '/campaigns', label: 'Campaigns' },
		{ href: '/member', label: 'Volunteer' },
		{ href: '/about-us', label: 'About Us' },
		{ href: '/faq', label: 'FAQ' },
		{ href: '/contact', label: 'Contact' },
		{ href: '/blog', label: 'Blog' },
		{ href: '/gallery', label: 'Gallery' }
	].filter((item) => {
		if (typeof currentPath === 'undefined') return true;
		return item.href !== currentPath;
	}).slice(0, 6);
%>
<section class="related-links-section">
	<div class="container">
		<div class="related-links-card">
			<h2 class="h5 mb-2">Explore more</h2>
			<p class="mb-3 text-muted">Helpful pages to learn, support, and get involved with Utthan Foundation.</p>
			<ul class="related-links-list">
				<% relatedLinks.forEach(function(link) { %>
					<li><a href="<%= link.href %>"><%= link.label %></a></li>
				<% }) %>
			</ul>
		</div>
	</div>
</section>
