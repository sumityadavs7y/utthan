<% if (typeof loaderStyle !== 'undefined' && loaderStyle === 'page-3') { %>
<div id="loading-area" class="loading-page-3">
	<div class="loading-inner">
		<div class="item1"></div>
		<div class="item2"></div>
		<div class="item3"></div>
		<div class="item4"></div>
	</div>
</div>
<% } else { %>
<div id="loading-area" class="loading-page-1">
	<div class="loading-inner">
		<div class="item-wrapper">
			<img class="item1" src="/images/hand1xxx.png" alt="" aria-hidden="true">
			<img class="item2" src="/images/hand2xxx.png" alt="" aria-hidden="true">
			<img class="item3" src="/images/heart.png" alt="" aria-hidden="true">
		</div>
		<div class="load-text">
			<span data-text="U" class="text-load">U</span>
			<span data-text="T" class="text-load">T</span>
			<span data-text="T" class="text-load">T</span>
			<span data-text="H" class="text-load">H</span>
			<span data-text="A" class="text-load">A</span>
			<span data-text="N" class="text-load">N</span>
			<span><br></span>
			<span data-text="F" class="text-load">F</span>
			<span data-text="O" class="text-load">O</span>
			<span data-text="U" class="text-load">U</span>
			<span data-text="N" class="text-load">N</span>
			<span data-text="D" class="text-load">D</span>
			<span data-text="A" class="text-load">A</span>
			<span data-text="T" class="text-load">T</span>
			<span data-text="I" class="text-load">I</span>
			<span data-text="O" class="text-load">O</span>
			<span data-text="N" class="text-load">N</span>
		</div>
	</div>
</div>
<% } %>
