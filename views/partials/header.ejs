<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="<%= siteName %> home">
      <img class="brand__logo" src="<%= siteConfig && siteConfig.logoUrl ? siteConfig.logoUrl : '/images/logo.png' %>" alt="Utthan Foundation" width="178" height="56">
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle__label">Menu</span>
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav>
      <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a>

      <div class="nav-item nav-item--dropdown <%= currentPath.startsWith('/about') ? 'is-current' : '' %>" data-dropdown>
        <button
          type="button"
          class="nav-link nav-link--button <%= currentPath.startsWith('/about') ? 'is-active' : '' %>"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="about-menu"
          data-dropdown-trigger
        >
          <span>About Us</span>
          <svg class="nav-caret" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
            <path d="M1 1.5 L6 6.5 L11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div id="about-menu" class="nav-panel" role="menu" data-dropdown-menu hidden>
          <a href="/about/who-we-are" role="menuitem" class="<%= currentPath === '/about/who-we-are' ? 'is-active' : '' %>">Who We Are</a>
          <a href="/about/history" role="menuitem" class="<%= currentPath === '/about/history' ? 'is-active' : '' %>">History</a>
          <a href="/about/leadership" role="menuitem" class="<%= currentPath === '/about/leadership' ? 'is-active' : '' %>">Leadership</a>
          <a href="/about/team" role="menuitem" class="<%= currentPath === '/about/team' ? 'is-active' : '' %>">Team</a>
        </div>
      </div>

      <a href="/campaigns" class="<%= currentPath.startsWith('/campaigns') ? 'is-active' : '' %>">Campaigns</a>
      <a href="/blogs" class="<%= currentPath.startsWith('/blogs') ? 'is-active' : '' %>">Blogs &amp; Media</a>
      <a href="/contact" class="<%= currentPath.startsWith('/contact') ? 'is-active' : '' %>">Contact</a>
      <a class="btn btn--donate" href="/donate">Donate</a>

      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="nav-item nav-item--dropdown <%= currentPath.startsWith('/admin') ? 'is-current' : '' %>" data-dropdown>
          <button
            type="button"
            class="nav-link nav-link--button <%= currentPath.startsWith('/admin') ? 'is-active' : '' %>"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="account-menu"
            data-dropdown-trigger
          >
            <span><%= currentUser.name %></span>
            <svg class="nav-caret" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
              <path d="M1 1.5 L6 6.5 L11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div id="account-menu" class="nav-panel" role="menu" data-dropdown-menu hidden>
            <% if (typeof can === 'function' && can('users.manage')) { %>
              <a href="/admin/users" role="menuitem" class="<%= currentPath.startsWith('/admin/users') ? 'is-active' : '' %>">Users</a>
            <% } %>
            <% if (typeof can === 'function' && can('roles.manage')) { %>
              <a href="/admin/roles" role="menuitem" class="<%= currentPath.startsWith('/admin/roles') ? 'is-active' : '' %>">Roles</a>
            <% } %>
            <% if (typeof can === 'function' && can('inbox.view')) { %>
              <a href="/admin/inbox" role="menuitem" class="<%= currentPath.startsWith('/admin/inbox') ? 'is-active' : '' %>">Inbox</a>
            <% } %>
            <% if (typeof can === 'function' && can('settings.edit') && siteConfig) { %>
              <button type="button" class="nav-panel__button" role="menuitem" data-cms-edit="site-config" data-id="<%= siteConfig.id %>">Site settings</button>
            <% } %>
            <form method="post" action="/logout" class="nav-panel__form">
              <%- csrfField %>
              <button type="submit" role="menuitem">Log out</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="<%= currentPath === '/login' ? 'is-active' : '' %>">Login</a>
      <% } %>
    </nav>
  </div>
</header>
