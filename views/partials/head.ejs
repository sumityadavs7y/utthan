<!-- Meta -->
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="keywords" content="">
<meta name="author" content="Utthan Foundation">
<meta name="robots" content="">
<meta name="description" content="Utthan Foundation - For The Ones In Need. Empowering underprivileged communities through education, healthcare, and livelihood development.">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Utthan Foundation' %>">
<meta property="og:description" content="Utthan Foundation Crowdfunding & Charity">
<meta name="format-detection" content="telephone=no">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title><%= typeof title !== 'undefined' ? title : 'Utthan Foundation' %></title>

<link rel="icon" type="image/png" href="/images/favicon.png">

<% if (typeof extraCss !== 'undefined' && extraCss && extraCss.length) { %>
	<% extraCss.forEach(function(href) { %>
<link href="<%= href %>" rel="stylesheet">
	<% }); %>
<% } %>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" class="skin" href="/css/skin/<%= typeof skin !== 'undefined' && skin ? skin : 'skin-1' %>.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
