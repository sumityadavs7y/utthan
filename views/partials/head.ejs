<!-- Meta -->
<%
	const pageSeo = seoHelpers.resolvePageSeo({
		currentPage: typeof currentPage !== 'undefined' ? currentPage : '',
		title: typeof title !== 'undefined' ? title : 'Utthan Foundation',
		metaDescription: typeof metaDescription !== 'undefined' ? metaDescription : null,
		metaKeywords: typeof metaKeywords !== 'undefined' ? metaKeywords : null,
		metaRobots: typeof metaRobots !== 'undefined' ? metaRobots : null,
		canonicalPath: typeof canonicalPath !== 'undefined' ? canonicalPath : (typeof currentPath !== 'undefined' ? currentPath : '/'),
		ogImage: typeof ogImage !== 'undefined' ? ogImage : null
	});
	const siteData = typeof site !== 'undefined' && site ? site : {};
	const orgJsonLd = seoHelpers.buildOrganizationJsonLd(siteData);
	const websiteJsonLd = seoHelpers.buildWebsiteJsonLd();
	const webPageJsonLd = seoHelpers.buildWebPageJsonLd(pageSeo);
	const breadcrumbJsonLd = seoHelpers.buildBreadcrumbJsonLd(pageSeo);
	const localJsonLd = seoHelpers.buildLocalBusinessJsonLd(siteData);
%>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="<%= pageSeo.description %>">
<meta name="keywords" content="<%= pageSeo.keywords %>">
<meta name="author" content="Utthan Foundation">
<meta name="robots" content="<%= pageSeo.robots %>">
<meta name="googlebot" content="<%= pageSeo.robots %>">
<meta name="theme-color" content="#003b4a">
<meta name="msapplication-TileColor" content="#003b4a">
<meta name="format-detection" content="telephone=no">
<meta name="geo.region" content="IN-UP">
<meta name="geo.placename" content="Lucknow">
<meta name="geo.position" content="26.7875;81.0231">
<meta name="ICBM" content="26.7875, 81.0231">
<link rel="canonical" href="<%= pageSeo.canonical %>">
<link rel="alternate" type="application/rss+xml" title="Utthan Foundation Blog RSS" href="/feed.xml">
<link rel="manifest" href="/site.webmanifest">
<link rel="author" type="text/plain" href="/humans.txt">

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= pageSeo.siteName %>">
<meta property="og:locale" content="<%= pageSeo.locale %>">
<meta property="og:title" content="<%= pageSeo.title %>">
<meta property="og:description" content="<%= pageSeo.description %>">
<meta property="og:url" content="<%= pageSeo.canonical %>">
<meta property="og:image" content="<%= pageSeo.ogImage %>">
<meta property="og:image:alt" content="Utthan Foundation">
<meta property="og:image:type" content="image/png">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageSeo.title %>">
<meta name="twitter:description" content="<%= pageSeo.description %>">
<meta name="twitter:image" content="<%= pageSeo.ogImage %>">
<meta name="twitter:image:alt" content="Utthan Foundation">

<title><%= pageSeo.title %></title>

<link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="apple-touch-icon" href="/images/logo.png">

<script type="application/ld+json"><%- JSON.stringify(orgJsonLd) %></script>
<script type="application/ld+json"><%- JSON.stringify(websiteJsonLd) %></script>
<script type="application/ld+json"><%- JSON.stringify(localJsonLd) %></script>
<% if (webPageJsonLd) { %><script type="application/ld+json"><%- JSON.stringify(webPageJsonLd) %></script><% } %>
<% if (breadcrumbJsonLd) { %><script type="application/ld+json"><%- JSON.stringify(breadcrumbJsonLd) %></script><% } %>

<% if (typeof extraCss !== 'undefined' && extraCss && extraCss.length) { %>
	<% extraCss.forEach(function(href) { %>
<link href="<%= href %>" rel="stylesheet">
	<% }); %>
<% } %>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" class="skin" href="/css/skin/<%= typeof skin !== 'undefined' && skin ? skin : 'skin-1' %>.css">
<link rel="stylesheet" href="/css/site-enhancements.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="dns-prefetch" href="//fonts.googleapis.com">
<link rel="dns-prefetch" href="//fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<% if (typeof currentPage !== 'undefined' && currentPage === 'home') { %>
<link rel="preload" as="image" href="/images/main-slider/slider2/pic1.png" fetchpriority="high">
<link rel="prefetch" href="/donate">
<link rel="prefetch" href="/campaigns">
<link rel="prefetch" href="/contact">
<% } %>
<% if (typeof currentPage !== 'undefined' && currentPage === 'faq' && typeof faqJsonLd !== 'undefined' && faqJsonLd) { %>
<script type="application/ld+json"><%- JSON.stringify(faqJsonLd) %></script>
<% } %>
