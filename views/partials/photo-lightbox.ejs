<div class="story-modal story-modal--lightbox" data-photo-lightbox hidden>
  <div class="story-modal__backdrop" data-photo-lightbox-close tabindex="-1"></div>
  <div
    class="story-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="photo-lightbox-title"
  >
    <button type="button" class="story-modal__close" data-photo-lightbox-close aria-label="Close photos">×</button>
    <div class="story-modal__scroll">
      <div class="story-modal__media" data-photo-lightbox-media>
        <div class="story-slider" data-photo-slider>
          <div class="story-slider__track" data-photo-slider-track></div>
          <button type="button" class="story-slider__nav story-slider__nav--prev" data-photo-slider-prev aria-label="Previous photo">‹</button>
          <button type="button" class="story-slider__nav story-slider__nav--next" data-photo-slider-next aria-label="Next photo">›</button>
          <div class="story-slider__dots" data-photo-slider-dots></div>
        </div>
      </div>
      <div class="story-modal__body" data-photo-lightbox-body>
        <h3 id="photo-lightbox-title" data-photo-lightbox-title></h3>
      </div>
    </div>
  </div>
</div>
