<footer class="site-footer">
  <div class="container footer-grid">
    <div class="cms-relative">
      <%- include('cms-bar', { permission: 'settings.edit', editType: 'page-block', id: footerBlock && footerBlock.id }) %>
      <p class="footer-brand"><%= footerBlock && footerBlock.title ? footerBlock.title : 'The Utthan Foundation' %></p>
      <p class="muted"><%= footerBlock && footerBlock.body ? footerBlock.body : 'An NGO uniting neighbors across Uttar Pradesh for food security, education, livelihood, and community care.' %></p>
      <% if (typeof socialLinks !== 'undefined' && socialLinks && socialLinks.length) { %>
        <ul class="footer-social" aria-label="Social media">
          <% socialLinks.forEach(function(link) { %>
            <li><a href="<%= link.url %>" rel="noopener noreferrer me" target="_blank"><%= link.label %></a></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
    <div>
      <h3>Explore</h3>
      <ul class="footer-links">
        <li><a href="/about/who-we-are">Who We Are</a></li>
        <li><a href="/about/history">History</a></li>
        <li><a href="/about/leadership">Leadership</a></li>
        <li><a href="/about/team">Team</a></li>
        <li><a href="/campaigns">Campaigns</a></li>
        <li><a href="/blogs">Blogs &amp; Media</a></li>
        <li><a href="/donate">Donate</a></li>
        <li><a href="/contact">Contact / Join</a></li>
      </ul>
    </div>
    <div>
      <h3>UP Office</h3>
      <% if (siteConfig) { %>
        <% if (siteConfig.address) { %><p><%= siteConfig.address %></p><% } %>
        <% if (siteConfig.phone) { %><p><a href="tel:<%= siteConfig.phone.replace(/\s/g, '') %>"><%= siteConfig.phone %></a></p><% } %>
        <% if (siteConfig.email) { %><p><a href="mailto:<%= siteConfig.email %>"><%= siteConfig.email %></a></p><% } %>
      <% } %>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> The Utthan Foundation. Serving communities across Uttar Pradesh.</p>
  </div>
</footer>
