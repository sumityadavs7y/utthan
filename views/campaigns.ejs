<%- include('partials/head-open') %>
<% const hero = blocks.hero || {}; %>

<section class="page-hero cms-relative">
  <%- include('partials/cms-bar', { permission: 'campaigns.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'Campaigns' %></p>
    <h1><%= hero.title || 'Campaigns for community relief & care' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cms-heading-row">
      <%- include('partials/cms-bar', { permission: 'campaigns.edit', addType: 'campaign' }) %>
    </div>
    <div class="tabs" role="tablist">
      <a class="tabs__item <%= status === 'ongoing' ? 'is-active' : '' %>" href="/campaigns?status=ongoing">Ongoing</a>
      <a class="tabs__item <%= status === 'completed' ? 'is-active' : '' %>" href="/campaigns?status=completed">Completed</a>
      <a class="tabs__item <%= status === 'upcoming' ? 'is-active' : '' %>" href="/campaigns?status=upcoming">Upcoming</a>
    </div>

    <% if (campaigns.length) { %>
      <div class="campaign-grid">
        <% campaigns.forEach(function(c) { %>
          <article class="cms-relative">
            <%- include('partials/cms-bar', { permission: 'campaigns.edit', editType: 'campaign', id: c.id, canDelete: true }) %>
            <a href="/campaigns/<%= c.slug %>" class="campaign-card">
              <div class="campaign-card__media">
                <img src="<%= c.imageUrl %>" alt="<%= c.title %>">
                <span class="badge"><%= c.status %></span>
              </div>
              <div class="campaign-card__body">
                <p class="eyebrow"><%= c.category %></p>
                <h3><%= c.title %></h3>
                <p><%= c.summary %></p>
                <% if (c.dateLabel) { %>
                  <p class="campaign-card__dates"><%= c.dateLabel %></p>
                <% } %>
                <div class="progress">
                  <div class="progress__bar" style="width: <%= c.progress %>%"></div>
                </div>
                <p class="progress__meta"><%= c.raisedFormatted %> / <%= c.goalFormatted %> · <%= c.progress %>%</p>
              </div>
            </a>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="muted">No <%= status %> campaigns right now.</p>
    <% } %>
  </div>
</section>

<%- include('partials/head-close') %>
