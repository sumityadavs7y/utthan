<%- include('partials/head-open') %>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">About Us</p>
    <h1>Who we are</h1>
    <p class="lede">The Utthan Foundation is a placeholder nonprofit working with communities across Uttar Pradesh on food security, education, livelihood, and care.</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <h2>Our story</h2>
      <p>Placeholder history: Utthan began as neighbors helping neighbors — sharing meals, school supplies, and winter kits. Today we organize campaigns with volunteers and local partners so help reaches villages with dignity.</p>
      <p>Replace this section with real founding dates, registration details, and milestones.</p>
    </div>
    <figure class="media-frame">
      <img src="/images/village-aid-notebooks.jpg" alt="Community outreach in a village courtyard">
    </figure>
  </div>
</section>

<% if (chairman) { %>
<section class="section section--tint">
  <div class="container split">
    <figure class="media-frame media-frame--portrait">
      <img src="<%= chairman.photoPath %>" alt="<%= chairman.name %>">
    </figure>
    <div>
      <h2>Leadership note</h2>
      <p class="quote-lead">“<%= chairman.message %>”</p>
      <p><strong><%= chairman.name %></strong><% if (chairman.role) { %> · <%= chairman.role %><% } %></p>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Chief Advisory Committee</h2>
      <p>Placeholder advisors guiding programs and ethics.</p>
    </div>
    <div class="people-grid">
      <% advisory.forEach(function(person) { %>
        <article class="person">
          <img src="<%= person.imagePath %>" alt="<%= person.name %>">
          <h3><%= person.name %></h3>
          <p class="muted"><%= person.designation %></p>
          <% if (person.bio) { %><p><%= person.bio %></p><% } %>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section-heading">
      <h2>Team</h2>
      <p>People coordinating programs day to day — placeholder profiles.</p>
    </div>
    <div class="people-grid">
      <% team.concat(volunteers).forEach(function(person) { %>
        <article class="person">
          <img src="<%= person.imagePath %>" alt="<%= person.name %>">
          <h3><%= person.name %></h3>
          <p class="muted"><%= person.designation %></p>
          <% if (person.bio) { %><p><%= person.bio %></p><% } %>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/head-close') %>
