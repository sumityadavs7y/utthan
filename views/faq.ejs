<!DOCTYPE html>
<html lang="en-IN">
<head>
	<%- include('partials/head') %>
</head>
<body id="bg">
<%- include('partials/loader') %>
<div class="page-wraper">
	<%- include('partials/header') %>

	<div id="main-content" class="page-content bg-white">
		<div class="dz-bnr-inr dz-bnr-inr-sm style-1 text-center overlay-primary-dark" style="background-image:url('/images/banner/bnr1.jpg');">
			<div class="container">
				<div class="dz-bnr-inr-entry">
					<h1>Frequently Asked Questions</h1>
					<nav aria-label="breadcrumb" class="breadcrumb-row">
						<ul class="breadcrumb">
							<li class="breadcrumb-item"><a href="/">Home</a></li>
							<li class="breadcrumb-item active" aria-current="page">FAQ</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>

		<section class="content-inner-1">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<p class="mb-4">Quick answers about Utthan Foundation, donations, volunteering, and how to get involved.</p>
						<div class="accordion" id="faqAccordion">
							<% faqs.forEach(function(item, index) { %>
								<div class="faq-item">
									<button
										type="button"
										data-bs-toggle="collapse"
										data-bs-target="#faq<%= index %>"
										aria-expanded="<%= index === 0 ? 'true' : 'false' %>"
										aria-controls="faq<%= index %>"
									>
										<%= item.question %>
									</button>
									<div id="faq<%= index %>" class="collapse <%= index === 0 ? 'show' : '' %>" data-bs-parent="#faqAccordion">
										<div class="faq-answer"><%= item.answer %></div>
									</div>
								</div>
							<% }) %>
						</div>
						<div class="mt-4">
							<a href="/donate" class="btn btn-primary me-2">Donate</a>
							<a href="/contact" class="btn btn-outline-secondary">Ask a question</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<%- include('partials/related-links') %>
	</div>

	<%- include('partials/newsletter') %>
	<%- include('partials/footer') %>
</div>
<%- include('partials/scripts') %>
</body>
</html>
