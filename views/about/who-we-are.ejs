<%- include('../partials/head-open') %>
<% const hero = blocks.hero || {}; const mission = blocks.mission || {}; const vision = blocks.vision || {}; const goal = blocks.goal || {}; %>

<section class="page-hero page-hero--compact cms-relative">
  <%- include('../partials/cms-bar', { permission: 'about.who_we_are.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'About Us' %></p>
    <h1><%= hero.title || 'Who We Are' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
    <%- include('../partials/about-nav') %>
  </div>
</section>

<section class="section">
  <div class="container split cms-relative">
    <%- include('../partials/cms-bar', { permission: 'about.who_we_are.edit', editType: 'page-block', id: mission.id }) %>
    <div>
      <h2><%= mission.title || 'Our mission' %></h2>
      <% (mission.paragraphs || []).forEach((para) => { %>
        <p><%= para %></p>
      <% }) %>
    </div>
    <figure class="media-frame">
      <img src="<%= mission.imageUrl || '' %>" alt="<%= mission.alt || '' %>">
    </figure>
  </div>
</section>

<section class="section section--tint">
  <div class="container split split--flip cms-relative">
    <%- include('../partials/cms-bar', { permission: 'about.who_we_are.edit', editType: 'page-block', id: vision.id }) %>
    <div>
      <h2><%= vision.title || 'Our vision' %></h2>
      <% (vision.paragraphs || []).forEach((para) => { %>
        <p><%= para %></p>
      <% }) %>
    </div>
    <figure class="media-frame">
      <img src="<%= vision.imageUrl || '' %>" alt="<%= vision.alt || '' %>">
    </figure>
  </div>
</section>

<section class="section">
  <div class="container split cms-relative">
    <%- include('../partials/cms-bar', { permission: 'about.who_we_are.edit', editType: 'page-block', id: goal.id }) %>
    <div>
      <h2><%= goal.title || 'Our goal' %></h2>
      <% (goal.paragraphs || []).forEach((para) => { %>
        <p><%= para %></p>
      <% }) %>
    </div>
    <figure class="media-frame">
      <img src="<%= goal.imageUrl || '' %>" alt="<%= goal.alt || '' %>">
    </figure>
  </div>
</section>

<%- include('../partials/head-close') %>
