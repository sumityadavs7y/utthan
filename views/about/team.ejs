<%- include('../partials/head-open') %>

<section class="page-hero page-hero--compact">
  <div class="container">
    <p class="eyebrow">About Us</p>
    <h1>Team</h1>
    <p class="lede">Meet the board and volunteers coordinating The Utthan Foundation’s programs day to day.</p>
    <%- include('../partials/about-nav') %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Core team</h2>
      <p>Program coordinators and field leads — placeholder profiles.</p>
    </div>
    <div class="people-grid people-grid--4">
      <% team.forEach(function(person) { %>
        <article class="campaign-card">
          <div class="campaign-card__media">
            <img src="<%= person.imagePath %>" alt="<%= person.name %>">
            <span class="badge">Team</span>
          </div>
          <div class="campaign-card__body">
            <h3><%= person.name %></h3>
            <% if (person.bio) { %>
              <p><%= person.bio %></p>
            <% } else { %>
              <p><%= person.designation %></p>
            <% } %>
            <p class="progress__meta"><%= person.designation %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section id="volunteers" class="section section--tint">
  <div class="container">
    <div class="section-heading">
      <h2>Volunteers</h2>
      <p>Field volunteers who keep campaigns moving — placeholder profiles.</p>
    </div>
    <div class="people-grid people-grid--4">
      <% volunteers.forEach(function(person) { %>
        <article class="campaign-card">
          <div class="campaign-card__media">
            <img src="<%= person.imagePath %>" alt="<%= person.name %>">
            <span class="badge">Volunteer</span>
          </div>
          <div class="campaign-card__body">
            <h3><%= person.name %></h3>
            <% if (person.bio) { %>
              <p><%= person.bio %></p>
            <% } else { %>
              <p><%= person.designation %></p>
            <% } %>
            <p class="progress__meta"><%= person.designation %></p>
          </div>
        </article>
      <% }) %>
    </div>
    <p class="join-hint"><a class="btn btn--secondary" href="/contact#join">Join as a volunteer</a></p>
  </div>
</section>

<%- include('../partials/head-close') %>
