<%- include('../partials/head-open') %>
<% const hero = blocks.hero || {}; const coreHead = blocks['core-heading'] || {}; const volHead = blocks['volunteers-heading'] || {}; %>

<section class="page-hero page-hero--compact cms-relative">
  <%- include('../partials/cms-bar', { permission: 'about.team.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'About Us' %></p>
    <h1><%= hero.title || 'Team' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
    <%- include('../partials/about-nav') %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('../partials/cms-bar', { permission: 'about.team.edit', editType: 'page-block', id: coreHead.id, addType: 'team-member', extra: '{"category":"board"}' }) %>
      <h2><%= coreHead.title || 'Core team' %></h2>
      <p><%= coreHead.lede || '' %></p>
    </div>
    <div class="people-grid people-grid--4">
      <% team.forEach(function(person) { %>
        <article class="campaign-card cms-relative">
          <%- include('../partials/cms-bar', { permission: 'about.team.edit', editType: 'team-member', id: person.id, canDelete: true }) %>
          <div class="campaign-card__media">
            <img src="<%= person.imageUrl %>" alt="<%= person.name %>">
            <span class="badge">Team</span>
          </div>
          <div class="campaign-card__body">
            <h3><%= person.name %></h3>
            <% if (person.bio) { %>
              <p><%= person.bio %></p>
            <% } else { %>
              <p><%= person.designation %></p>
            <% } %>
            <p class="progress__meta"><%= person.designation %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section id="volunteers" class="section section--tint">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('../partials/cms-bar', { permission: 'about.team.edit', editType: 'page-block', id: volHead.id, addType: 'team-member', extra: '{"category":"volunteer"}' }) %>
      <h2><%= volHead.title || 'Volunteers' %></h2>
      <p><%= volHead.lede || '' %></p>
    </div>
    <div class="people-grid people-grid--4">
      <% volunteers.forEach(function(person) { %>
        <article class="campaign-card cms-relative">
          <%- include('../partials/cms-bar', { permission: 'about.team.edit', editType: 'team-member', id: person.id, canDelete: true }) %>
          <div class="campaign-card__media">
            <img src="<%= person.imageUrl %>" alt="<%= person.name %>">
            <span class="badge">Volunteer</span>
          </div>
          <div class="campaign-card__body">
            <h3><%= person.name %></h3>
            <% if (person.bio) { %>
              <p><%= person.bio %></p>
            <% } else { %>
              <p><%= person.designation %></p>
            <% } %>
            <p class="progress__meta"><%= person.designation %></p>
          </div>
        </article>
      <% }) %>
    </div>
    <p class="join-hint"><a class="btn btn--secondary" href="/contact#join">Join as a volunteer</a></p>
  </div>
</section>

<%- include('../partials/head-close') %>
