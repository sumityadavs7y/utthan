<%- include('../partials/head-open') %>
<% const hero = blocks.hero || {}; const story = blocks.story || {}; const growth = blocks.growth || {}; %>

<section class="page-hero page-hero--compact cms-relative">
  <%- include('../partials/cms-bar', { permission: 'about.history.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'About Us' %></p>
    <h1><%= hero.title || 'History' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
    <%- include('../partials/about-nav') %>
  </div>
</section>

<section class="section">
  <div class="container split cms-relative">
    <%- include('../partials/cms-bar', { permission: 'about.history.edit', editType: 'page-block', id: story.id }) %>
    <div>
      <h2><%= story.title || 'Our story' %></h2>
      <% (story.paragraphs || []).forEach((para) => { %>
        <p><%= para %></p>
      <% }) %>
    </div>
    <figure class="media-frame">
      <img src="<%= story.imageUrl || '' %>" alt="<%= story.alt || '' %>">
    </figure>
  </div>
</section>

<section class="section section--tint">
  <div class="container split split--flip cms-relative">
    <%- include('../partials/cms-bar', { permission: 'about.history.edit', editType: 'page-block', id: growth.id }) %>
    <div>
      <h2><%= growth.title || 'How we grew' %></h2>
      <% (growth.paragraphs || []).forEach((para) => { %>
        <p><%= para %></p>
      <% }) %>
    </div>
    <figure class="media-frame">
      <img src="<%= growth.imageUrl || '' %>" alt="<%= growth.alt || '' %>">
    </figure>
  </div>
</section>

<%- include('../partials/head-close') %>
