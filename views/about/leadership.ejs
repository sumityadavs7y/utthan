<%- include('../partials/head-open') %>
<% const hero = blocks.hero || {}; const advisoryHead = blocks['advisory-heading'] || {}; const governingHead = blocks['governing-heading'] || {}; %>

<section class="page-hero page-hero--compact cms-relative">
  <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', editType: 'page-block', id: hero.id }) %>
  <div class="container">
    <p class="eyebrow"><%= hero.eyebrow || 'About Us' %></p>
    <h1><%= hero.title || 'Leadership' %></h1>
    <p class="lede"><%= hero.lede || '' %></p>
    <%- include('../partials/about-nav') %>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!chairman) { %>
      <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', addType: 'chairman' }) %>
    <% } %>
    <% if (chairman) { %>
      <div class="split leadership-note cms-relative">
        <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', editType: 'chairman', id: chairman.id }) %>
        <figure class="media-frame media-frame--portrait">
          <img src="<%= chairman.imageUrl %>" alt="<%= chairman.name %>">
        </figure>
        <div>
          <h2>Chairperson note</h2>
          <p class="quote-lead">“<%= chairman.message %>”</p>
          <p><strong><%= chairman.name %></strong><% if (chairman.role) { %> · <%= chairman.role %><% } %></p>
        </div>
      </div>
    <% } %>
  </div>
</section>

<section id="chief-advisory-committee" class="section section--tint">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', editType: 'page-block', id: advisoryHead.id }) %>
      <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', addType: 'team-member', extra: '{"category":"advisory"}' }) %>
      <h2><%= advisoryHead.title || 'Chief Advisory Committee' %></h2>
      <p><%= advisoryHead.lede || '' %></p>
    </div>
    <div class="people-grid">
      <% advisory.forEach(function(person) { %>
        <article class="campaign-card cms-relative">
          <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', editType: 'team-member', id: person.id, canDelete: true }) %>
          <div class="campaign-card__media">
            <img src="<%= person.imageUrl %>" alt="<%= person.name %>">
            <span class="badge">Advisor</span>
          </div>
          <div class="campaign-card__body">
            <h3><%= person.name %></h3>
            <% if (person.bio) { %>
              <p><%= person.bio %></p>
            <% } else { %>
              <p><%= person.designation %></p>
            <% } %>
            <p class="progress__meta"><%= person.designation %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section id="governing-body" class="section">
  <div class="container">
    <div class="section-heading cms-relative">
      <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', editType: 'page-block', id: governingHead.id }) %>
      <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', addType: 'team-member', extra: '{"category":"governing"}' }) %>
      <h2><%= governingHead.title || 'Governing Body' %></h2>
      <p><%= governingHead.lede || '' %></p>
    </div>
    <div class="people-grid people-grid--4">
      <% governing.forEach(function(person) { %>
        <article class="campaign-card cms-relative">
          <%- include('../partials/cms-bar', { permission: 'about.leadership.edit', editType: 'team-member', id: person.id, canDelete: true }) %>
          <div class="campaign-card__media">
            <img src="<%= person.imageUrl %>" alt="<%= person.name %>">
            <span class="badge">Governing</span>
          </div>
          <div class="campaign-card__body">
            <h3><%= person.name %></h3>
            <% if (person.bio) { %>
              <p><%= person.bio %></p>
            <% } else { %>
              <p><%= person.designation %></p>
            <% } %>
            <p class="progress__meta"><%= person.designation %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/head-close') %>
